<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <!-- 1. Persistence Unit (Блок настроек) -->
    <persistence-unit name="tennis" transaction-type="RESOURCE_LOCAL">

        <!-- 2. Провайдер JPA -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- 3. Список классов-сущностей -->
        <class>org.example.model.Player</class>
        <class>org.example.model.Match</class>
        <!-- Если добавим Score, его тоже нужно будет сюда вписать -->

        <!-- 4. Свойства для подключения и настройки Hibernate -->
        <properties>
            <!-- === Настройки подключения к БД === -->

            <!-- Это нестандартное свойство, специфичное для Hibernate -->
            <property name="hibernate.connection.provider_class" value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>

            <!-- Теперь мы настраиваем сам HikariCP через его собственные свойства -->
            <property name="hibernate.hikari.dataSource.url" value="jdbc:postgresql://localhost:54793/tennis_db"/>
            <property name="hibernate.hikari.dataSource.user" value="tennis_user"/>
            <property name="hibernate.hikari.dataSource.password" value="test"/>

            <!-- === Настройки специфичные для Hibernate === -->

            <!-- Диалект SQL. Очень важный параметр! -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- Показывать сгенерированный SQL в консоли. НЕВЕРОЯТНО полезно для отладки! -->
            <property name="hibernate.show_sql" value="true"/>

            <!-- Форматировать SQL в консоли, чтобы его было удобно читать. -->
            <property name="hibernate.format_sql" value="true"/>

            <!-- Стратегия генерации/обновления схемы БД. -->
            <!-- 'validate': Проверять, что схема БД соответствует сущностям. Если нет - ошибка. (Для продакшена) -->
            <!-- 'update': Автоматически добавлять/изменять колонки и таблицы. (Удобно для разработки) -->
            <!-- 'create': Каждый раз удалять и создавать всю схему заново. (Для тестов) -->
            <!-- 'create-drop': То же, что и create, но удаляет схему при закрытии сессии. (Для тестов) -->
            <!-- 'none': Ничего не делать. (Стандарт для продакшена, где схемой управляют миграции) -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
        </properties>

    </persistence-unit>
</persistence>